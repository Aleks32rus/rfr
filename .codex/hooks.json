{
  "description": "Синхронная компиляция после изменения Java и фронтенда",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/compile.mjs\"",
            "commandWindows": "powershell.exe -NoProfile -Command \"& node ((git rev-parse --show-toplevel) + '/.codex/hooks/compile.mjs')\"",
            "timeout": 30,
            "statusMessage": "Запоминаю содержимое исходников"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/compile.mjs\"",
            "commandWindows": "powershell.exe -NoProfile -Command \"& node ((git rev-parse --show-toplevel) + '/.codex/hooks/compile.mjs')\"",
            "timeout": 600,
            "additionalContextLimit": 2500,
            "statusMessage": "Компилирую изменённый код"
          }
        ]
      }
    ]
  }
}
